# Claude (required)
ANTHROPIC_API_KEY=

# Twitter / X
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=

# WordPress (use Application Passwords from /wp-admin/profile.php)
WORDPRESS_URL=https://yourblog.com
WORDPRESS_USER=admin
WORDPRESS_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# YouTube OAuth2 (create credentials at console.cloud.google.com)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:3000/oauth2callback

# OpenAI (for DALL-E 3 image generation — platform.openai.com/api-keys)
OPENAI_API_KEY=

# Google Analytics (GA4) Data API — 人気記事の集計に使用
# PROPERTY_ID は GA4 管理 → プロパティ設定の数字。OAuth 値は OAuth Playground 等で取得。
GA4_PROPERTY_ID=
GA_OAUTH_CLIENT_ID=
GA_OAUTH_CLIENT_SECRET=
GA_OAUTH_REFRESH_TOKEN=
