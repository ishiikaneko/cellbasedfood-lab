# Claude (required)
ANTHROPIC_API_KEY=

# Twitter / X
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=

# WordPress (use Application Passwords from /wp-admin/profile.php)
WORDPRESS_URL=https://yourblog.com
WORDPRESS_USER=admin
WORDPRESS_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# YouTube OAuth2 (create credentials at console.cloud.google.com)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:3000/oauth2callback

# OpenAI (for DALL-E 3 image generation — platform.openai.com/api-keys)
OPENAI_API_KEY=

# リポジトリルートパス（PCローカル実行時のみ設定が必要）
# GitHub Actions では自動設定されるため不要
# Windows例: SITE_REPO_PATH=C:/Users/Yuji Matsuyoshi/Downloads/cellbasedfood-lab
# Mac/Linux例: SITE_REPO_PATH=/Users/yuji/cellbasedfood-lab
SITE_REPO_PATH=
