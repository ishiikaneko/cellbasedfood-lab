---
const categories = ['すべて', '細胞', '培養液', '培養方法', 'その他培養資材', '細胞性食品', 'コラム'];
---

<header class="site-header">
  <nav class="nav">
    <a href="/" class="logo" aria-label="CellBasedFood Lab トップへ">
      <div class="logo-mark" aria-hidden="true">
        <svg viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg">
          <circle cx="7" cy="7" r="3" fill="white" opacity=".9"/>
          <circle cx="2.5" cy="4" r="1.5" fill="white" opacity=".55"/>
          <circle cx="11.5" cy="4" r="1.5" fill="white" opacity=".55"/>
          <circle cx="2.5" cy="10" r="1.5" fill="white" opacity=".55"/>
          <circle cx="11.5" cy="10" r="1.5" fill="white" opacity=".55"/>
        </svg>
      </div>
      <span class="logo-name">CellBasedFood Lab</span>
    </a>

    <!-- PC: 中央タグライン -->
    <span class="nav-center">培養肉研究員による専門情報サイト</span>

    <!-- PC: インライン検索 -->
    <form class="search-form" action="/search" method="get" role="search">
      <div class="search-wrap">
        <label for="search-input" class="sr-only">サイト内検索</label>
        <input
          id="search-input"
          type="search"
          name="q"
          placeholder="サイト内検索"
          autocomplete="off"
        />
        <button type="submit" aria-label="検索">
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round">
            <circle cx="6.5" cy="6.5" r="4"/>
            <line x1="10" y1="10" x2="14" y2="14"/>
          </svg>
        </button>
      </div>
    </form>

    <!-- SP: ハンバーガーボタン -->
    <button class="hamburger" id="menu-toggle" aria-label="メニューを開く" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>
  </nav>

  <!-- SP: ドロワーメニュー -->
  <div class="sp-drawer" id="sp-drawer" aria-hidden="true">
    <form class="sp-search" action="/search" method="get" role="search">
      <input type="search" name="q" placeholder="サイト内検索" />
      <button type="submit" aria-label="検索">
        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round">
          <circle cx="6.5" cy="6.5" r="4"/><line x1="10" y1="10" x2="14" y2="14"/>
        </svg>
      </button>
    </form>
    <nav class="sp-nav-links">
      {categories.map(cat => (
        <a
          href={cat === 'すべて' ? '/' : `/?category=${encodeURIComponent(cat)}`}
          class={`sp-cat-link${cat === 'すべて' ? ' active' : ''}`}
          data-cat={cat}
        >{cat}</a>
      ))}
    </nav>
  </div>

  <!-- カテゴリーバー (PC) -->
  <div class="cat-bar" role="navigation" aria-label="カテゴリー">
    <div class="cat-row">
      <span class="bar-label">カテゴリー</span>
      {categories.map(cat => (
        <a
          href={cat === 'すべて' ? '/' : `/?category=${encodeURIComponent(cat)}`}
          class={`cat-pill${cat === 'すべて' ? ' on' : ''}`}
          data-cat={cat}
        >{cat}</a>
      ))}
    </div>
  </div>
</header>

<style>
/* ── SITE HERO ── */
/* ── NAV CENTER TAGLINE ── */
.nav-center {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  font-size: 12px;
  color: #0F6E56;
  font-family: 'Noto Sans JP', sans-serif;
  white-space: nowrap;
  letter-spacing: .02em;
  pointer-events: none;
}

/* ── NAV ── */
.site-header {
  position: sticky;
  top: 0;
  z-index: 100;
  background: #fff;
  border-bottom: 0.5px solid #e5e4df;
}

.nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24px;
  height: 52px;
  max-width: 1200px;
  margin: 0 auto;
}

.logo {
  display: flex;
  align-items: center;
  gap: 9px;
  flex-shrink: 0;
  text-decoration: none;
}

.logo-mark {
  width: 28px;
  height: 28px;
  background: #0F6E56;
  border-radius: 5px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.logo-mark svg { width: 17px; height: 17px; }

.logo-name {
  font-family: 'Space Mono', monospace;
  font-size: 15px;
  font-weight: 700;
  color: #0F6E56;
  letter-spacing: .04em;
}

/* ── SEARCH (PC) ── */
.search-form { display: flex; }
.search-wrap {
  display: flex;
  align-items: center;
  background: #f5f4f0;
  border: 0.5px solid #dddbd4;
  border-radius: 8px;
  overflow: hidden;
  width: 148px;
  height: 24px;
}
.search-wrap input {
  border: none;
  background: transparent;
  font-size: 12px;
  padding: 0 7px;
  width: 100%;
  height: 100%;
  outline: none;
  font-family: 'Noto Sans JP', sans-serif;
  color: #1a1a18;
}
.search-wrap input::placeholder { color: #888; font-size: 12px; }
.search-wrap button {
  width: 24px;
  height: 24px;
  background: transparent;
  border: none;
  border-left: 0.5px solid #dddbd4;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  color: #888;
  transition: background .15s, color .15s;
}
.search-wrap button:hover { background: #0F6E56; color: #fff; }
.search-wrap button svg { width: 12px; height: 12px; }

/* ── HAMBURGER (SP only) ── */
.hamburger {
  display: none;
  flex-direction: column;
  justify-content: center;
  gap: 5px;
  width: 32px;
  height: 32px;
  background: transparent;
  border: none;
  cursor: pointer;
  padding: 4px;
}
.hamburger span {
  display: block;
  width: 100%;
  height: 1.5px;
  background: #1a1a18;
  border-radius: 2px;
  transition: transform .2s, opacity .2s;
}
.hamburger.open span:nth-child(1) { transform: translateY(6.5px) rotate(45deg); }
.hamburger.open span:nth-child(2) { opacity: 0; }
.hamburger.open span:nth-child(3) { transform: translateY(-6.5px) rotate(-45deg); }

/* ── SP DRAWER ── */
.sp-drawer {
  display: none;
  padding: 12px 20px 16px;
  background: #fff;
  border-top: 0.5px solid #e5e4df;
}
.sp-drawer.open { display: block; }
.sp-search {
  display: flex;
  align-items: center;
  background: #f5f4f0;
  border: 0.5px solid #dddbd4;
  border-radius: 8px;
  overflow: hidden;
  margin-bottom: 12px;
}
.sp-search input {
  border: none;
  background: transparent;
  font-size: 15px;
  padding: 8px 12px;
  width: 100%;
  outline: none;
  font-family: 'Noto Sans JP', sans-serif;
}
.sp-search button {
  width: 36px; height: 36px;
  border: none; border-left: 0.5px solid #dddbd4;
  background: transparent;
  cursor: pointer;
  display: flex; align-items: center; justify-content: center;
  color: #888;
}
.sp-search button svg { width: 14px; height: 14px; }
.sp-nav-links {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
}
.sp-cat-link {
  font-size: 14px;
  padding: 4px 12px;
  border-radius: 20px;
  border: 0.5px solid #dddbd4;
  color: #666;
  text-decoration: none;
  transition: all .15s;
}
.sp-cat-link.active,
.sp-cat-link:hover { background: #0F6E56; color: #fff; border-color: #0F6E56; }

/* ── CATEGORY BAR (PC) ── */
.cat-bar {
  border-top: 0.5px solid #e5e4df;
  padding: 0 24px;
  max-width: 1200px;
  margin: 0 auto;
}
.cat-row {
  display: flex;
  align-items: center;
  gap: 5px;
  padding: 7px 0;
  flex-wrap: wrap;
}
.bar-label {
  font-size: 13px;
  color: #888;
  white-space: nowrap;
  margin-right: 4px;
  flex-shrink: 0;
}
.cat-pill {
  font-size: 13px;
  padding: 3px 10px;
  border-radius: 20px;
  cursor: pointer;
  white-space: nowrap;
  border: 0.5px solid #dddbd4;
  color: #666;
  text-decoration: none;
  transition: all .15s;
}
.cat-pill.on,
.cat-pill:hover { background: #0F6E56; color: #fff; border-color: #0F6E56; }

/* ── RESPONSIVE ── */
@media (max-width: 768px) {
  .search-form { display: none; }
  .hamburger { display: flex; }
  .cat-bar { display: none; }
  .nav { padding: 0 16px; }
  .nav-center { display: none; }
}
</style>

<script>
const toggle = document.getElementById('menu-toggle');
const drawer = document.getElementById('sp-drawer');
toggle?.addEventListener('click', () => {
  const open = toggle.classList.toggle('open');
  toggle.setAttribute('aria-expanded', String(open));
  drawer?.classList.toggle('open', open);
  drawer?.setAttribute('aria-hidden', String(!open));
});
</script>
