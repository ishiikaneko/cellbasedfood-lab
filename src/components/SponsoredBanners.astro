---
// variant: 'home'（3列グリッド）or 'sidebar'（縦積み）
const { variant = 'home' } = Astro.props;
const DISPLAY_COUNT = 3;
const LABEL = variant === 'sidebar' ? 'BANNERS' : 'Sponsored';

const FALLBACK_URLS = [
  'https://amzn.to/4e4lE2Q',
  'https://amzn.to/4cuO3Oq',
  'https://amzn.to/3Qm6I6x',
  'https://amzn.to/4sTaH7O',
  'https://amzn.to/4sTaNMI',
  'https://amzn.to/4uaxsFv',
  'https://amzn.to/4udSzXI',
];

interface OgpItem {
  url: string;
  title: string | null;
  author: string | null;
}

let ogpItems: OgpItem[] = [];

try {
  const { readFileSync } = await import('node:fs');
  const { join } = await import('node:path');
  const raw = readFileSync(join(process.cwd(), 'src/data/ogp-cache.json'), 'utf-8');
  ogpItems = (JSON.parse(raw) as { items: OgpItem[] }).items ?? [];
} catch {
  ogpItems = FALLBACK_URLS.map(url => ({ url, title: null, author: null }));
}
---

<div
  class={`sp-banners sp-banners--${variant}`}
  aria-label="広告"
  data-ogp={JSON.stringify(ogpItems)}
>
  <p class="sp-label">{LABEL}</p>
  <div class="sp-slots">
    {Array.from({ length: DISPLAY_COUNT }).map(() => (
      <div class="sp-slot sp-placeholder" aria-hidden="true"></div>
    ))}
  </div>
</div>

<script>
interface OgpItem {
  url: string;
  title: string | null;
  author: string | null;
}

function getRandomItems<T>(arr: T[], count: number): T[] {
  return [...arr].sort(() => Math.random() - 0.5).slice(0, Math.min(count, arr.length));
}

function escapeHtml(str: string): string {
  return str
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;');
}

function buildCard(item: OgpItem): string {
  const title  = item.title  ?? 'Amazon商品を見る';
  const author = item.author ?? '';

  return `<a
    href="${escapeHtml(item.url)}"
    target="_blank"
    rel="noopener noreferrer sponsored"
    class="sp-slot sp-card"
  >
    <p class="sp-title">${escapeHtml(title)}</p>
    ${author ? `<p class="sp-author">${escapeHtml(author)}</p>` : ''}
    <span class="sp-cta">amazon.co.jp ↗</span>
  </a>`;
}

document.addEventListener('DOMContentLoaded', () => {
  document.querySelectorAll<HTMLElement>('.sp-banners').forEach(container => {
    const raw = container.dataset.ogp;
    if (!raw) return;

    let items: OgpItem[] = [];
    try { items = JSON.parse(raw); } catch { return; }

    const picks   = getRandomItems(items, 3);
    const slotsEl = container.querySelector('.sp-slots');
    if (!slotsEl) return;

    slotsEl.innerHTML = picks.map(buildCard).join('');
  });
});
</script>

<style>
.sp-label {
  font-family: 'Space Mono', monospace;
  font-size: 9px;
  letter-spacing: .1em;
  color: #888;
  text-transform: uppercase;
  margin: 0 0 6px;
  padding: 0 16px;
}

/* ─── Home: 3列グリッド（icon-rowと同じ幅感） ────────────────────────── */
.sp-banners--home .sp-slots {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  border-top: 0.5px solid #e5e4df;
}

/* ─── Sidebar: 縦積み ───────────────────────────────────────────────────── */
.sp-banners--sidebar .sp-slots {
  display: flex;
  flex-direction: column;
  gap: 6px;
}

/* ─── プレースホルダー ───────────────────────────────────────────────────── */
.sp-placeholder {
  height: 68px;
  background: #fafaf8;
  border-right: 0.5px solid #e5e4df;
}
.sp-placeholder:last-child { border-right: none; }

/* ─── カード共通 ──────────────────────────────────────────────────────────── */
.sp-card {
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 3px;
  padding: 10px 12px;
  border-right: 0.5px solid #e5e4df;
  text-decoration: none;
  color: inherit;
  transition: background .15s;
}
.sp-card:last-child { border-right: none; }
.sp-card:hover { background: #f5f4f0; }

.sp-title {
  font-family: 'Noto Serif JP', serif;
  font-size: 10px;
  font-weight: 500;
  line-height: 1.5;
  color: #1a1a18;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  margin: 0;
}

.sp-author {
  font-size: 9px;
  color: #999;
  line-height: 1.4;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  margin: 0;
}

.sp-cta {
  font-family: 'Space Mono', monospace;
  font-size: 8px;
  color: #0F6E56;
  letter-spacing: .04em;
}

/* ─── Sidebar variant ───────────────────────────────────────────────────── */
.sp-banners--sidebar .sp-card {
  border-right: none;
  border: 1px solid #e5e4df;
  border-radius: 6px;
  padding: 8px 10px;
}
.sp-banners--sidebar .sp-card:hover {
  border-color: #d0cfc9;
  box-shadow: 0 1px 4px rgba(0,0,0,.05);
}

/* ─── モバイル ───────────────────────────────────────────────────────────── */
@media (max-width: 768px) {
  .sp-title { font-size: 9px; }
  .sp-author { font-size: 8px; }
  .sp-card { padding: 8px 8px; gap: 2px; }
  .sp-placeholder { height: 56px; }
}
</style>
