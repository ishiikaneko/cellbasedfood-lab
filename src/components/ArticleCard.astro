---
interface Props {
  title: string;
  slug: string;
  pubDate: Date;
  category: string;
  heroImage?: string;
  aiGenerated?: boolean;
  searchText?: string;
}

const { title, slug, pubDate, category, heroImage, aiGenerated = false, searchText } = Astro.props;

const dateStr = pubDate.toLocaleDateString('ja-JP', {
  month: '2-digit',
  day: '2-digit',
}).replace('/', '.');
---

<a href={`/blog/${slug}`} class="art-card" data-card-cat={category} data-search-text={searchText ?? ''}>
  <div class="art-thumb">
    {heroImage
      ? <img src={heroImage} alt={title} loading="lazy" />
      : <div class="thumb-placeholder" aria-hidden="true">
          <svg width="60" height="44" viewBox="0 0 60 44" fill="none">
            <circle cx="30" cy="22" r="10" fill="#0F6E56" opacity=".14"/>
            <circle cx="30" cy="22" r="5.5" fill="#0F6E56" opacity=".3"/>
            <circle cx="30" cy="22" r="2.5" fill="#0F6E56" opacity=".55"/>
            <circle cx="12" cy="12" r="3.5" fill="#1D9E75" opacity=".22"/>
            <circle cx="12" cy="12" r="1.8" fill="#1D9E75" opacity=".4"/>
            <circle cx="48" cy="12" r="3.5" fill="#1D9E75" opacity=".22"/>
            <circle cx="48" cy="12" r="1.8" fill="#1D9E75" opacity=".4"/>
            <circle cx="12" cy="32" r="3.5" fill="#1D9E75" opacity=".22"/>
            <circle cx="12" cy="32" r="1.8" fill="#1D9E75" opacity=".4"/>
            <circle cx="48" cy="32" r="3.5" fill="#1D9E75" opacity=".22"/>
            <circle cx="48" cy="32" r="1.8" fill="#1D9E75" opacity=".4"/>
            <line x1="30" y1="12" x2="30" y2="16.5" stroke="#0F6E56" stroke-width="0.8" opacity=".25"/>
            <line x1="30" y1="27.5" x2="30" y2="32" stroke="#0F6E56" stroke-width="0.8" opacity=".25"/>
            <line x1="15.5" y1="15" x2="22" y2="19" stroke="#1D9E75" stroke-width="0.7" opacity=".2"/>
            <line x1="38" y1="19" x2="44.5" y2="15" stroke="#1D9E75" stroke-width="0.7" opacity=".2"/>
            <line x1="15.5" y1="29" x2="22" y2="25" stroke="#1D9E75" stroke-width="0.7" opacity=".2"/>
            <line x1="38" y1="25" x2="44.5" y2="29" stroke="#1D9E75" stroke-width="0.7" opacity=".2"/>
          </svg>
        </div>
    }
    {heroImage && heroImage.endsWith('.png') && <span class="gen-badge" aria-label="AI生成画像">DALL-E 3</span>}
  </div>

  <div class="art-meta">
    <span class={`tag tag-${category}`}>{category}</span>
    {aiGenerated && <span class="ai-dot" aria-label="AI生成記事" />}
    <time datetime={pubDate.toISOString()} class="art-date">{dateStr}</time>
  </div>

  <p class="art-title">{title}</p>
</a>

<style>
.art-card {
  display: block;
  padding: 10px 12px;
  text-decoration: none;
  color: inherit;
  transition: background .15s;
  border-right: 0.5px solid #e5e4df;
  border-bottom: 0.5px solid #e5e4df;
}
.art-card:hover { background: #f5f4f0; }

/* サムネイル */
.art-thumb {
  width: 100%;
  height: 80px;
  border-radius: 8px;
  margin-bottom: 8px;
  overflow: hidden;
  position: relative;
  background: #f0ede6;
  display: flex;
  align-items: center;
  justify-content: center;
}
.art-thumb img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform .4s ease;
}
.art-card:hover .art-thumb img { transform: scale(1.04); }
.art-thumb::after {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(to bottom, transparent 55%, rgba(0,0,0,0.12));
  pointer-events: none;
}
.thumb-placeholder {
  width: 100%;
  height: 100%;
  background: radial-gradient(ellipse at 35% 40%, #c4eede 0%, #E1F5EE 40%, #b8ddd0 100%);
  display: flex;
  align-items: center;
  justify-content: center;
}

/* メタ */
.art-meta {
  display: flex;
  align-items: center;
  gap: 5px;
  margin-bottom: 4px;
  flex-wrap: wrap;
}
.art-date {
  font-family: 'Space Mono', monospace;
  font-size: 11px;
  color: #888;
}

/* タイトル */
.art-title {
  font-family: 'Noto Serif JP', serif;
  font-size: 13px;
  font-weight: 500;
  line-height: 1.65;
  color: #1a1a18;
}
</style>
