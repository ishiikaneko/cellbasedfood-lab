---
import '../styles/global.css';
import Analytics from '@vercel/analytics/astro';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  structuredData?: object;
}

const SITE_DEFAULT_TITLE = '細胞培養食品ラボ│CellBasedFood lab';
const SITE_NAME = '細胞培養食品ラボ';
const SITE_OG_NAME = '細胞培養食品ラボ│CellBasedFood lab';

const {
  title = SITE_DEFAULT_TITLE,
  description = '現役の培養肉研究員が開発現場から解説する、培養肉専門の技術情報サイトです。',
  ogImage = '/og/og-default.png',
  structuredData,
} = Astro.props;

// X や Facebook のカードクローラーは og:image に SVG を指定しても画像と認識しない
// （PNG/JPEG/WebP/GIF のみ対応）。記事のヒーロー画像は SVG なので、
// scripts/generate-og-images.mjs がビルド時に焼き込む /og/*.png を OGP に使う。
const ogImageRaster = ogImage.startsWith('/images/') && ogImage.endsWith('.svg')
  ? ogImage.replace(/^\/images\//, '/og/').replace(/\.svg$/, '.png')
  : ogImage;
const ogImageURL = new URL(ogImageRaster, Astro.site);

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

// 記事ページはタイトルに「｜細胞培養食品ラボ」を付与、トップ等はそのまま
const seoTitle = title === SITE_DEFAULT_TITLE
  ? SITE_DEFAULT_TITLE
  : `${title}｜${SITE_NAME}`;
---
<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />

  <!-- OGP -->
  <meta property="og:type" content="website" />
  <meta property="og:title" content={seoTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImageURL} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:site_name" content={SITE_OG_NAME} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={seoTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageURL} />

  <title>{seoTitle}</title>

  <!-- Google Search Console -->
  <meta name="google-site-verification" content="noQjWWgUQj3hxPLsmSsAtrc8s20luu0sq60b1PKKX8s" />

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <!-- 構造化データ -->
  {structuredData && (
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  )}

  <!-- Google Analytics (GA4) -->
  <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-6LS5WRVW8J"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-6LS5WRVW8J');
  </script>

</head>
<body>
  <slot />
  <Analytics />
</body>
</html>
