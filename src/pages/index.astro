---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import ArticleCard from '../components/ArticleCard.astro';
import Footer from '../components/Footer.astro';
import SponsoredBanners from '../components/SponsoredBanners.astro';
import { getCollection } from 'astro:content';

// ── 全記事取得（下書き除外・日付降順） ──
const allPosts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// ── 表示対象（最大50本） ──
const displayPosts = allPosts.slice(0, 50);

// ── 人気記事（本番では analytics から popular.json を読む。現在はダミー） ──
const popularPosts = allPosts.slice(0, 3);
---

<BaseLayout>
  <div class="page-wrapper">
    <Header />

    <main class="main-content">
      <div class="inner">

        <!-- ── HERO（最新記事） ── -->
        {allPosts.length > 0 && (
          <section class="hero-area" aria-labelledby="hero-heading">
            <a href={`/blog/${allPosts[0].slug}`} class="hero-inner">
              <div class="hero-body">
                <div class="hero-badge">
                  <span class={`tag tag-${allPosts[0].data.category}`}>{allPosts[0].data.category}</span>
                  <time datetime={allPosts[0].data.pubDate.toISOString()} class="hero-date">
                    {allPosts[0].data.pubDate.toLocaleDateString('ja-JP', { month: '2-digit', day: '2-digit' }).replace('/', '.')}
                  </time>
                </div>
                <h2 id="hero-heading" class="hero-title">{allPosts[0].data.title}</h2>
                <p class="hero-desc">{allPosts[0].data.description}</p>
                <span class="hero-read">記事を読む →</span>
              </div>
              <div class="hero-thumb" style={allPosts[0].data.heroImage ? '' : 'background:linear-gradient(135deg,#E1F5EE,#5DCAA5);'}>
                {allPosts[0].data.heroImage
                  ? <img src={allPosts[0].data.heroImage} alt={allPosts[0].data.title} />
                  : <svg viewBox="0 0 64 64" fill="none" width="64" height="64"><circle cx="32" cy="32" r="14" fill="#0F6E56" opacity=".2"/><circle cx="32" cy="32" r="8" fill="#0F6E56" opacity=".4"/><circle cx="14" cy="20" r="5" fill="#1D9E75" opacity=".35"/><circle cx="50" cy="20" r="5" fill="#1D9E75" opacity=".35"/><circle cx="14" cy="44" r="5" fill="#1D9E75" opacity=".35"/><circle cx="50" cy="44" r="5" fill="#1D9E75" opacity=".35"/></svg>
                }
                <span class="gen-badge">DALL-E 3</span>
              </div>
            </a>
          </section>
        )}

        <!-- ── LATEST ARTICLES ── -->
        <section class="articles-section" aria-labelledby="latest-heading">
          <div class="sec-head">
            <h2 id="latest-heading" class="sec-label">最新記事</h2>
            <span class="sec-count" id="art-count">{displayPosts.length} / 全{allPosts.length}本</span>
          </div>

          {displayPosts.length > 0 ? (
            <div class="art-grid" id="art-grid">
              {displayPosts.map(post => (
                <ArticleCard
                  title={post.data.title}
                  slug={post.slug}
                  pubDate={post.data.pubDate}
                  category={post.data.category}
                  heroImage={post.data.heroImage}
                  aiGenerated={post.data.aiGenerated}
                />
              ))}
            </div>
          ) : (
            <p class="empty-msg" id="empty-msg" style="display:none">該当する記事がまだありません。</p>
          )}
          <p class="empty-msg" id="filter-empty" style="display:none">このカテゴリーの記事はまだありません。</p>
        </section>

        <!-- ── PAGINATION / MORE ── -->
        {allPosts.length > 50 && (
          <div class="more-zone">
            <div class="page-dots" aria-hidden="true">
              <span class="pdot cur"></span>
              <span class="pdot"></span>
              <span class="pdot"></span>
              <span class="pdot"></span>
              <span class="pdot"></span>
            </div>
            <a href="/blog" class="more-btn">以前の記事はこちら →</a>
            <span class="page-sub">50本 / ページ</span>
          </div>
        )}

        <!-- ── POPULAR ── -->
        <section class="pop-zone" aria-labelledby="popular-heading">
          <div class="pop-head">
            <h2 id="popular-heading" class="pop-label">人気記事</h2>
          </div>
          <div class="pop-grid">
            {popularPosts.map((post, i) => (
              <a href={`/blog/${post.slug}`} class="pop-card">
                <span class="pop-rank" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                <div class="pop-tag-row">
                  <span class={`tag tag-${post.data.category}`}>{post.data.category}</span>
                </div>
                <p class="pop-title">{post.data.title}</p>
              </a>
            ))}
          </div>
        </section>

        <!-- ── ICON LINKS ── -->
        <section class="icon-row" aria-label="コンテンツページ">
          <a href="/column" class="icon-btn">
            <div class="icon-wrap" style="background:#E1F5EE;" aria-hidden="true">
              <svg width="30" height="30" viewBox="0 0 30 30" fill="none">
                <rect x="5" y="4" width="14" height="2" rx="1" fill="#0F6E56" opacity=".9"/>
                <rect x="5" y="9" width="20" height="1.5" rx=".75" fill="#0F6E56" opacity=".5"/>
                <rect x="5" y="13" width="20" height="1.5" rx=".75" fill="#0F6E56" opacity=".5"/>
                <rect x="5" y="17" width="15" height="1.5" rx=".75" fill="#0F6E56" opacity=".5"/>
                <circle cx="22" cy="22" r="6" fill="#0F6E56" opacity=".15"/>
                <path d="M19.5 22 L21 23.5 L24.5 20" stroke="#0F6E56" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
            <span class="icon-btn-label">コラム</span>
            <span class="icon-btn-sub">培養肉から少し焦点が外れた、<br />周辺情報に関する記事はこちら。</span>
            <span class="icon-arr" aria-hidden="true">専用ページへ →</span>
          </a>
          <a href="/links" class="icon-btn">
            <div class="icon-wrap" style="background:#E6F1FB;" aria-hidden="true">
              <svg width="30" height="30" viewBox="0 0 30 30" fill="none">
                <circle cx="15" cy="15" r="9" stroke="#185FA5" stroke-width="1.5" opacity=".4"/>
                <ellipse cx="15" cy="15" rx="4.5" ry="9" stroke="#185FA5" stroke-width="1.5" opacity=".4"/>
                <line x1="6" y1="15" x2="24" y2="15" stroke="#185FA5" stroke-width="1.5" opacity=".5"/>
                <line x1="7.5" y1="10" x2="22.5" y2="10" stroke="#185FA5" stroke-width="1" opacity=".35"/>
                <line x1="7.5" y1="20" x2="22.5" y2="20" stroke="#185FA5" stroke-width="1" opacity=".35"/>
                <circle cx="15" cy="15" r="2.5" fill="#185FA5" opacity=".6"/>
              </svg>
            </div>
            <span class="icon-btn-label">情報サイトリンク集</span>
            <span class="icon-btn-sub">論文DB・政府資料・業界団体<br />厳選リソースを一覧で</span>
            <span class="icon-arr" aria-hidden="true">専用ページへ →</span>
          </a>
        </section>

        <!-- ── SPONSORED ── -->
        <section class="aff-zone">
          <SponsoredBanners />
        </section>

      </div>
    </main>

    <Footer />
  </div>

  <script>
  (function () {
    function getActiveCat() {
      return new URLSearchParams(window.location.search).get('category') ?? 'すべて';
    }

    function applyFilter(cat) {
      const grid = document.getElementById('art-grid');
      const countEl = document.getElementById('art-count');
      const filterEmpty = document.getElementById('filter-empty');

      if (grid) {
        const cards = grid.querySelectorAll('[data-card-cat]');
        let visibleCount = 0;
        cards.forEach(function (card) {
          const show = cat === 'すべて' || card.dataset.cardCat === cat;
          card.style.display = show ? '' : 'none';
          if (show) visibleCount++;
        });

        if (filterEmpty) filterEmpty.style.display = visibleCount === 0 ? '' : 'none';
        if (countEl) countEl.textContent = visibleCount + ' / 全' + cards.length + '本';
      }

      document.querySelectorAll('[data-cat]').forEach(function (el) {
        el.classList.toggle('on', el.dataset.cat === cat);
        el.classList.toggle('active', el.dataset.cat === cat);
      });

      const url = new URL(window.location.href);
      if (cat === 'すべて') {
        url.searchParams.delete('category');
      } else {
        url.searchParams.set('category', cat);
      }
      history.replaceState(null, '', url.toString());
    }

    applyFilter(getActiveCat());

    document.querySelectorAll('[data-cat]').forEach(function (el) {
      el.addEventListener('click', function (e) {
        e.preventDefault();
        applyFilter(el.dataset.cat || 'すべて');

        const drawer = document.getElementById('sp-drawer');
        const toggle = document.getElementById('menu-toggle');
        if (drawer && drawer.classList.contains('open')) {
          drawer.classList.remove('open');
          drawer.setAttribute('aria-hidden', 'true');
          toggle && toggle.classList.remove('open');
          toggle && toggle.setAttribute('aria-expanded', 'false');
        }
      });
    });
  })();
  </script>
</BaseLayout>

<style>
/* ── LAYOUT ── */
.page-wrapper { display: flex; flex-direction: column; min-height: 100vh; }
.main-content { flex: 1; }
.inner { max-width: 1200px; margin: 0 auto; }

/* ── HERO AREA（週間人気記事） ── */
.hero-area {
  border-bottom: 0.5px solid #e5e4df;
}
.hero-inner {
  display: grid;
  grid-template-columns: 1fr 220px;
  text-decoration: none;
  color: inherit;
  transition: background .15s;
  min-height: 180px;
}
.hero-inner:hover { background: #f5f4f0; }
.hero-body {
  padding: 22px 24px;
}
.hero-badge {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 10px;
}
.hero-date {
  font-family: 'Space Mono', monospace;
  font-size: 11px;
  color: #888;
}
.hero-title {
  font-family: 'Noto Serif JP', serif;
  font-size: 22px;
  font-weight: 500;
  line-height: 1.7;
  color: #1a1a18;
  margin-bottom: 10px;
}
.hero-desc {
  font-size: 14px;
  color: #888;
  line-height: 1.75;
}
.hero-read {
  display: inline-block;
  margin-top: 12px;
  font-size: 13px;
  color: #0F6E56;
  font-family: 'Space Mono', monospace;
}
.hero-thumb {
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow: hidden;
}
.hero-thumb img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

/* ── SECTION HEAD ── */
.sec-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12px 24px 8px;
}
.sec-label {
  font-family: 'Space Mono', monospace;
  font-size: 11px;
  letter-spacing: .1em;
  color: #888;
  text-transform: uppercase;
  font-weight: 400;
}
.sec-count { font-size: 12px; color: #888; }

/* ── ARTICLE GRID ── */
.art-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  border-top: 0.5px solid #e5e4df;
}
/* 3の倍数カードの右ボーダーを消す */
.art-grid > :nth-child(3n) { border-right: none; }
/* 最下行カードの下ボーダーを消す */
.art-grid > :nth-last-child(-n+3):nth-child(3n+1),
.art-grid > :nth-last-child(-n+3):nth-child(3n+2),
.art-grid > :nth-last-child(-n+3):nth-child(3n)  { border-bottom: none; }

.empty-msg {
  padding: 32px 24px;
  font-size: 15px;
  color: #888;
  text-align: center;
}

/* ── MORE / PAGINATION ── */
.more-zone {
  padding: 14px 24px;
  border-top: 0.5px solid #e5e4df;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 7px;
}
.page-dots { display: flex; gap: 4px; }
.pdot { width: 6px; height: 6px; border-radius: 50%; background: #dddbd4; }
.pdot.cur { background: #0F6E56; }
.more-btn {
  font-size: 13px;
  color: #0F6E56;
  padding: 6px 20px;
  border: 0.5px solid #0F6E56;
  border-radius: 20px;
  text-decoration: none;
  transition: background .15s;
}
.more-btn:hover { background: #E1F5EE; }
.page-sub { font-size: 12px; color: #888; font-family: 'Space Mono', monospace; }

/* ── POPULAR ── */
.pop-zone { border-top: 0.5px solid #e5e4df; }
.pop-head {
  display: flex;
  align-items: center;
  gap: 7px;
  padding: 12px 24px 8px;
}
.pop-label {
  font-family: 'Space Mono', monospace;
  font-size: 11px;
  letter-spacing: .1em;
  color: #888;
  text-transform: uppercase;
  font-weight: 400;
}
.pop-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  border-top: 0.5px solid #e5e4df;
}
.pop-card {
  padding: 12px 14px;
  border-right: 0.5px solid #e5e4df;
  position: relative;
  text-decoration: none;
  color: inherit;
  display: block;
  transition: background .15s;
}
.pop-card:hover { background: #f5f4f0; }
.pop-card:last-child { border-right: none; }
.pop-rank {
  font-family: 'Space Mono', monospace;
  font-size: 26px;
  font-weight: 700;
  color: #E1F5EE;
  position: absolute;
  top: 8px;
  right: 10px;
  line-height: 1;
}
.pop-tag-row { display: flex; align-items: center; gap: 4px; margin-bottom: 5px; }
.pop-title {
  font-family: 'Noto Serif JP', serif;
  font-size: 13px;
  font-weight: 500;
  line-height: 1.65;
  color: #1a1a18;
}

/* ── ICON BUTTONS ── */
.icon-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  border-top: 0.5px solid #e5e4df;
}
.icon-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 22px 16px;
  text-decoration: none;
  color: inherit;
  border-right: 0.5px solid #e5e4df;
  transition: background .15s;
}
.icon-btn:last-child { border-right: none; }
.icon-btn:hover { background: #f5f4f0; }
.icon-wrap {
  width: 56px;
  height: 56px;
  border-radius: 14px;
  display: flex;
  align-items: center;
  justify-content: center;
}
.icon-btn-label {
  font-family: 'Noto Serif JP', serif;
  font-size: 15px;
  font-weight: 500;
  color: #1a1a18;
}
.icon-btn-sub {
  font-size: 12px;
  color: #888;
  text-align: center;
  line-height: 1.6;
}
.icon-arr { font-size: 12px; color: #0F6E56; font-family: 'Space Mono', monospace; }

/* ── AFFILIATE ── */
.aff-zone {
  border-top: 0.5px solid #e5e4df;
  padding: 10px 0 0;
}

/* ── RESPONSIVE ── */
@media (max-width: 768px) {
  .hero-inner { grid-template-columns: 1fr; }
  .hero-thumb { height: 160px; }
  .hero-title { font-size: 17px; }
  .hero-body { padding: 16px; }
  .sec-head { padding: 10px 16px 6px; }

  /* 記事：1列 */
  .art-grid { grid-template-columns: 1fr; }
  .art-grid > * { border-right: none !important; }

  /* 人気：1列 */
  .pop-grid { grid-template-columns: 1fr; }
  .pop-card { border-right: none; border-bottom: 0.5px solid #e5e4df; }
  .pop-card:last-child { border-bottom: none; }

  .more-zone { padding: 12px 16px; }
  .tag-area { padding: 10px 16px; }
  .pop-head { padding: 10px 16px 8px; }

  .inner { max-width: 100%; }
}

@media (max-width: 480px) {
  /* アイコンボタン：小さめ */
  .icon-btn { padding: 16px 12px; gap: 6px; }
  .big-icon { width: 40px; height: 40px; font-size: 20px; }
  .icon-btn-label { font-size: 14px; }
}
</style>
