---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const linkGroups = [
  {
    label: 'ニュース・業界動向',
    links: [
      { name: 'Cultivated Meat News', url: 'https://cultivated-meat.maubon.com/', desc: '培養肉関連のニュース・研究・規制動向を横断的に追える海外ニュース集約サイト。' },
      { name: 'Green Queen', url: 'https://www.greenqueen.com.hk/category/cellbased-protein-cultivated-meat/', desc: '気候・サステナビリティの視点から、培養肉や代替タンパク質の企業・政策・市場ニュースを扱う海外メディア。' },
      { name: 'Foovo', url: 'https://foodtech-japan.com/', desc: '海外の培養肉・代替タンパク質・フードテック動向を日本語で追える専門メディア。' },
    ],
  },
  {
    label: '規制・安全性',
    links: [
      { name: '消費者庁｜新開発食品調査部会', url: 'https://www.caa.go.jp/policies/council/fssc/meeting_materials/review_meeting_004/', desc: '日本での細胞培養食品を含む新開発食品の制度・安全性議論を確認できる消費者庁の会議資料ページ。' },
      { name: 'FDA（米国）', url: 'https://www.hfpappexternal.fda.gov/scripts/fdcc/index.cfm?set=animalcellculturefoods', desc: 'FDAが完了した培養動物細胞由来食品の市販前相談資料・回答書・科学メモを確認できる公式リスト。' },
      { name: 'USDA-FSIS（米国）', url: 'https://www.fsis.usda.gov/inspection/compliance-guidance/labeling/labeling-policies/human-food-made-cultured-animal-cells', desc: '米国で畜肉・家きん由来の細胞培養食品を扱う際の表示・監督情報を確認できる公式ページ。' },
      { name: 'UK Food Standards Agency', url: 'https://www.food.gov.uk/business-guidance/cell-cultivated-products', desc: '英国での細胞培養食品の認可申請、安全性評価、表示、試食試験に関するFSA公式ガイダンス。' },
    ],
  },
  {
    label: '国内団体・コンソーシアム',
    links: [
      { name: 'JACA｜一般社団法人細胞農業研究機構', url: 'https://jaca.jp/', desc: '日本の細胞性食品に関する情報発信、政策・制度面の議論、国際連携に取り組む一般社団法人。' },
      { name: '特定非営利法人日本細胞農業協会', url: 'https://cellagri.org/', desc: '細胞農業の普及啓発、教育、イベント、研究支援に取り組む日本の非営利団体。' },
      { name: '日本培養食料学会', url: 'https://www.cultivated-food.org/', desc: '細胞性食品・培養食料分野の研究者・実務者が集まる国内学術団体。' },
      { name: 'クラフトエッセン協議会', url: 'https://craft-essen.com/', desc: '家きん由来の細胞培養食品「クラフトエッセン」の社会受容と上市に向け、情報発信や勉強会を行う国内協議会。' },
      { name: '培養肉未来創造コンソーシアム', url: 'https://cficm.jp/', desc: '培養肉の研究開発・展示・社会実装を進める大阪大学を中心とした国内コンソーシアム。' },
    ],
  },
  {
    label: '海外団体・ネットワーク',
    links: [
      { name: 'The Good Food Institute (GFI)', url: 'https://gfi.org/cultivated/', desc: '代替タンパク質分野の研究・政策・産業支援を行う国際的な非営利シンクタンク。' },
      { name: 'GFI JAPAN', url: 'https://gfi.or.jp/', desc: '代替タンパク質分野の動向を日本語で発信するGFIの日本拠点' },
      { name: 'Cellular Agriculture Europe', url: 'https://www.cellularagriculture.eu/', desc: '欧州における細胞農業の政策・産業動向を発信する業界団体' },
      { name: 'Cellular Agriculture Australia', url: 'https://www.cellularagricultureaustralia.org/', desc: '豪州の細胞農業・代替タンパク質分野を支援する団体' },
      { name: 'APAC-SCA', url: 'https://www.apac-sca.org/', desc: 'アジア太平洋地域で、培養食品・精密発酵製品を扱う企業の政策・規制対応を支援する業界団体。' },
      { name: 'New Harvest', url: 'https://www.new-harvest.org/', desc: '細胞農業を公共性の高い技術として育てるため、研究支援・教育・コミュニティ形成を行う非営利団体。' },
      { name: 'The Cultivarian Society', url: 'https://www.cultivarian.food/', desc: '動物を屠畜しない肉を広げるため、培養肉の認知向上・政策提言・倫理的消費の発信を行う団体。' },
    ],
  },
  {
    label: '研究・アカデミア・その他',
    links: [
      { name: 'Tufts Center for Cellular Agriculture', url: 'https://cellularagriculture.tufts.edu/', desc: '細胞農業の研究・教育・商業化支援を進めるタフツ大学の研究拠点。' },
      { name: 'Shojinmeat Project', url: 'https://shojinmeat.com/', desc: '自宅・DIYスケールでの培養肉づくりを探る、日本発のオープンソース型コミュニティ。' },
      { name: 'Cellbase', url: 'https://cellbase.com/ja', desc: '培養肉開発向けの細胞株・培地・足場材・装置などを扱うB2Bマーケットプレイス。' },
    ],
  },
];
---

<BaseLayout title="情報サイトリンク集" description="培養肉業界の関連サイトはこちら">
  <div class="page-wrapper">
    <Header />

    <main class="main-content">
      <div class="inner">

        <div class="page-head">
          <a href="/" class="back-link">← トップへ</a>
          <div class="page-title-row">
            <div class="page-icon" aria-hidden="true">
              <svg width="30" height="30" viewBox="0 0 30 30" fill="none">
                <circle cx="15" cy="15" r="9" stroke="#185FA5" stroke-width="1.5" opacity=".4"/>
                <ellipse cx="15" cy="15" rx="4.5" ry="9" stroke="#185FA5" stroke-width="1.5" opacity=".4"/>
                <line x1="6" y1="15" x2="24" y2="15" stroke="#185FA5" stroke-width="1.5" opacity=".5"/>
                <line x1="7.5" y1="10" x2="22.5" y2="10" stroke="#185FA5" stroke-width="1" opacity=".35"/>
                <line x1="7.5" y1="20" x2="22.5" y2="20" stroke="#185FA5" stroke-width="1" opacity=".35"/>
                <circle cx="15" cy="15" r="2.5" fill="#185FA5" opacity=".6"/>
              </svg>
            </div>
            <div>
              <h1 class="page-title">情報サイトリンク集</h1>
              <p class="page-desc">培養肉業界の関連サイトはこちら</p>
            </div>
          </div>
        </div>

        <div class="links-body">
          {linkGroups.map(group => (
            <section class="link-group">
              <h2 class="group-label">{group.label}</h2>
              <ul class="link-list">
                {group.links.map(link => (
                  <li>
                    <a href={link.url} target="_blank" rel="noopener noreferrer" class="link-card">
                      <span class="link-name">{link.name}</span>
                      <span class="link-desc">{link.desc}</span>
                      <span class="link-ext" aria-hidden="true">↗</span>
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          ))}
        </div>

      </div>
    </main>

    <Footer />
  </div>
</BaseLayout>

<style>
.page-wrapper { display: flex; flex-direction: column; min-height: 100vh; }
.main-content { flex: 1; }
.inner { max-width: 1200px; margin: 0 auto; }

.page-head {
  padding: 16px 24px 20px;
  border-bottom: 0.5px solid #e5e4df;
}
.back-link {
  font-size: 12px;
  color: #888;
  text-decoration: none;
  font-family: 'Space Mono', monospace;
  display: inline-block;
  margin-bottom: 14px;
  transition: color .15s;
}
.back-link:hover { color: #0F6E56; }
.page-title-row {
  display: flex;
  align-items: center;
  gap: 14px;
}
.page-icon {
  width: 56px;
  height: 56px;
  background: #E6F1FB;
  border-radius: 14px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.page-title {
  font-family: 'Noto Serif JP', serif;
  font-size: 22px;
  font-weight: 500;
  color: #1a1a18;
  margin-bottom: 4px;
}
.page-desc {
  font-size: 13px;
  color: #888;
  line-height: 1.6;
}

.links-body {
  padding: 0 24px 40px;
}

.link-group {
  margin-top: 32px;
}
.group-label {
  font-family: 'Space Mono', monospace;
  font-size: 11px;
  letter-spacing: .1em;
  color: #888;
  text-transform: uppercase;
  font-weight: 400;
  margin-bottom: 10px;
  padding-bottom: 8px;
  border-bottom: 0.5px solid #e5e4df;
}

.link-list {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-direction: column;
  gap: 0;
}
.link-list li {
  border-bottom: 0.5px solid #e5e4df;
}
.link-list li:last-child { border-bottom: none; }

.link-card {
  display: flex;
  align-items: baseline;
  gap: 12px;
  padding: 12px 4px;
  text-decoration: none;
  color: inherit;
  transition: background .15s;
  border-radius: 4px;
  position: relative;
}
.link-card:hover { background: #f5f4f0; }

.link-name {
  font-family: 'Noto Serif JP', serif;
  font-size: 14px;
  font-weight: 500;
  color: #1a1a18;
  white-space: nowrap;
  flex-shrink: 0;
}
.link-desc {
  font-size: 13px;
  color: #888;
  line-height: 1.5;
}
.link-ext {
  margin-left: auto;
  font-size: 13px;
  color: #0F6E56;
  flex-shrink: 0;
}

@media (max-width: 768px) {
  .page-head { padding: 14px 16px 16px; }
  .links-body { padding: 0 16px 32px; }
  .link-card { flex-wrap: wrap; gap: 4px; }
  .link-ext { margin-left: 0; }
  .inner { max-width: 100%; }
}
</style>
