---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import ArticleCard from '../components/ArticleCard.astro';
import Footer from '../components/Footer.astro';
import { getCollection } from 'astro:content';

const allPosts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const columnPosts = allPosts.filter(p => p.data.category === 'コラム');
---

<BaseLayout title="コラム" description="石井金子のオリジナル記事">
  <div class="page-wrapper">
    <Header />

    <main class="main-content">
      <div class="inner">

        <div class="page-head">
          <a href="/" class="back-link">← トップへ</a>
          <div class="page-title-row">
            <div class="page-icon" aria-hidden="true">
              <svg width="30" height="30" viewBox="0 0 30 30" fill="none">
                <rect x="5" y="4" width="14" height="2" rx="1" fill="#0F6E56" opacity=".9"/>
                <rect x="5" y="9" width="20" height="1.5" rx=".75" fill="#0F6E56" opacity=".5"/>
                <rect x="5" y="13" width="20" height="1.5" rx=".75" fill="#0F6E56" opacity=".5"/>
                <rect x="5" y="17" width="15" height="1.5" rx=".75" fill="#0F6E56" opacity=".5"/>
                <circle cx="22" cy="22" r="6" fill="#0F6E56" opacity=".15"/>
                <path d="M19.5 22 L21 23.5 L24.5 20" stroke="#0F6E56" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
            <div>
              <h1 class="page-title">コラム</h1>
              <p class="page-desc">石井金子のオリジナル記事</p>
            </div>
          </div>
        </div>

        {columnPosts.length > 0 ? (
          <section class="articles-section">
            <div class="sec-head">
              <span class="sec-label">コラム記事</span>
              <span class="sec-count">{columnPosts.length}本</span>
            </div>
            <div class="art-grid">
              {columnPosts.map(post => (
                <ArticleCard
                  title={post.data.title}
                  slug={post.slug}
                  pubDate={post.data.pubDate}
                  category={post.data.category}
                  heroImage={post.data.heroImage}
                  aiGenerated={post.data.aiGenerated}
                />
              ))}
            </div>
          </section>
        ) : (
          <div class="empty-state">
            <div class="empty-icon" aria-hidden="true">
              <svg width="48" height="48" viewBox="0 0 48 48" fill="none">
                <rect x="8" y="6" width="22" height="3" rx="1.5" fill="#0F6E56" opacity=".2"/>
                <rect x="8" y="14" width="32" height="2" rx="1" fill="#0F6E56" opacity=".15"/>
                <rect x="8" y="20" width="32" height="2" rx="1" fill="#0F6E56" opacity=".15"/>
                <rect x="8" y="26" width="24" height="2" rx="1" fill="#0F6E56" opacity=".15"/>
              </svg>
            </div>
            <p class="empty-msg">コラム記事は現在準備中です。</p>
          </div>
        )}

      </div>
    </main>

    <Footer />
  </div>
</BaseLayout>

<style>
.page-wrapper { display: flex; flex-direction: column; min-height: 100vh; }
.main-content { flex: 1; }
.inner { max-width: 1200px; margin: 0 auto; }

.page-head {
  padding: 16px 24px 20px;
  border-bottom: 0.5px solid #e5e4df;
}
.back-link {
  font-size: 12px;
  color: #888;
  text-decoration: none;
  font-family: 'Space Mono', monospace;
  display: inline-block;
  margin-bottom: 14px;
  transition: color .15s;
}
.back-link:hover { color: #0F6E56; }
.page-title-row {
  display: flex;
  align-items: center;
  gap: 14px;
}
.page-icon {
  width: 56px;
  height: 56px;
  background: #E1F5EE;
  border-radius: 14px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.page-title {
  font-family: 'Noto Serif JP', serif;
  font-size: 22px;
  font-weight: 500;
  color: #1a1a18;
  margin-bottom: 4px;
}
.page-desc {
  font-size: 13px;
  color: #888;
  line-height: 1.6;
}

.articles-section { }
.sec-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12px 24px 8px;
}
.sec-label {
  font-family: 'Space Mono', monospace;
  font-size: 11px;
  letter-spacing: .1em;
  color: #888;
  text-transform: uppercase;
  font-weight: 400;
}
.sec-count { font-size: 12px; color: #888; }

.art-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  border-top: 0.5px solid #e5e4df;
}
.art-grid > :nth-child(3n) { border-right: none; }
.art-grid > :nth-last-child(-n+3):nth-child(3n+1),
.art-grid > :nth-last-child(-n+3):nth-child(3n+2),
.art-grid > :nth-last-child(-n+3):nth-child(3n)  { border-bottom: none; }

.empty-state {
  padding: 60px 24px;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16px;
  border-top: 0.5px solid #e5e4df;
}
.empty-msg {
  font-size: 14px;
  color: #888;
}

@media (max-width: 768px) {
  .page-head { padding: 14px 16px 16px; }
  .art-grid { grid-template-columns: 1fr; }
  .art-grid > * { border-right: none !important; }
  .sec-head { padding: 10px 16px 6px; }
  .inner { max-width: 100%; }
}
</style>
