---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import SponsoredBanners from '../../components/SponsoredBanners.astro';
import NewsletterSignup from '../../components/NewsletterSignup.astro';
import { getCollection } from 'astro:content';
import { getPopularPosts } from '../../utils/popular.js';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map(post => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();

// 関連記事（同カテゴリー・自分以外・最大2件）
const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const related = allPosts
  .filter(p => p.slug !== post.slug && p.data.category === post.data.category)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 2);

// 人気記事（popular.json があれば analytics から、なければ最新3本）
const sortedByDate = [...allPosts].sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const popularPosts = getPopularPosts(sortedByDate);

const dateStr = post.data.pubDate.toLocaleDateString('ja-JP', {
  year: 'numeric', month: '2-digit', day: '2-digit'
}).replace(/\//g, '.');

const pageUrl = new URL(`/blog/${post.slug}`, Astro.site ?? Astro.url.origin).href;
const xShareUrl = `https://twitter.com/intent/tweet?text=${encodeURIComponent(post.data.title)}&url=${encodeURIComponent(pageUrl)}`;

// 一次ソース（frontmatter references）を schema.org の citation に流す。
// 本文の「引用文献」セクションは人間可読の表示、こちらは検索エンジン向けの機械可読。
const citations = (post.data.references ?? []).map((r) => ({
  "@type": "CreativeWork",
  "name": r.title,
  "url": r.url,
}));
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  ogImage={post.data.heroImage}
  ogType="article"
  publishedTime={post.data.pubDate.toISOString()}
  structuredData={{
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "headline": post.data.title,
    "description": post.data.description,
    "datePublished": post.data.pubDate.toISOString(),
    "dateModified": post.data.pubDate.toISOString(),
    "url": pageUrl,
    "mainEntityOfPage": { "@type": "WebPage", "@id": pageUrl },
    "articleSection": post.data.category,
    "keywords": post.data.tags,
    ...(post.data.heroImage ? { "image": new URL(post.data.heroImage, Astro.site ?? Astro.url.origin).href } : {}),
    ...(citations.length ? { "citation": citations } : {}),
    "author": {
      "@type": "Organization",
      "name": "細胞培養食品ラボ",
      "alternateName": "CellBasedFood Lab"
    },
    "publisher": {
      "@type": "Organization",
      "name": "細胞培養食品ラボ",
      "alternateName": "CellBasedFood Lab"
    }
  }}
>
  <div class="page-wrapper">
    <Header />

    <main class="main-content">
      <div class="inner">

        <!-- BREADCRUMB -->
        <nav class="breadcrumb" aria-label="パンくずリスト">
          <a href="/">トップ</a>
          <span aria-hidden="true"> › </span>
          <a href={`/?category=${encodeURIComponent(post.data.category)}`}>{post.data.category}</a>
          <span aria-hidden="true"> › </span>
          <span>{post.data.title}</span>
        </nav>

        <!-- ARTICLE + SIDEBAR -->
        <div class="article-wrap">

          <!-- ── MAIN ── -->
          <article class="article-main">

            <!-- ヒーロー画像 -->
            <div class="art-hero-img">
              {post.data.heroImage
                ? <img src={post.data.heroImage} alt={post.data.title} />
                : <div class="hero-placeholder">
                    <svg viewBox="0 0 80 80" fill="none" width="88" height="88">
                      <circle cx="40" cy="40" r="18" fill="#0F6E56" opacity=".11"/>
                      <circle cx="40" cy="40" r="11" fill="#0F6E56" opacity=".24"/>
                      <circle cx="40" cy="40" r="5"  fill="#0F6E56" opacity=".48"/>
                      <circle cx="16" cy="24" r="7"  fill="#1D9E75" opacity=".16"/>
                      <circle cx="16" cy="24" r="3.5" fill="#1D9E75" opacity=".36"/>
                      <circle cx="64" cy="24" r="7"  fill="#1D9E75" opacity=".16"/>
                      <circle cx="64" cy="24" r="3.5" fill="#1D9E75" opacity=".36"/>
                      <circle cx="16" cy="56" r="7"  fill="#1D9E75" opacity=".16"/>
                      <circle cx="16" cy="56" r="3.5" fill="#1D9E75" opacity=".36"/>
                      <circle cx="64" cy="56" r="7"  fill="#1D9E75" opacity=".16"/>
                      <circle cx="64" cy="56" r="3.5" fill="#1D9E75" opacity=".36"/>
                      <line x1="23" y1="28" x2="31" y2="35" stroke="#1D9E75" stroke-width="1" opacity=".22"/>
                      <line x1="49" y1="35" x2="57" y2="28" stroke="#1D9E75" stroke-width="1" opacity=".22"/>
                      <line x1="23" y1="52" x2="31" y2="45" stroke="#1D9E75" stroke-width="1" opacity=".22"/>
                      <line x1="49" y1="45" x2="57" y2="52" stroke="#1D9E75" stroke-width="1" opacity=".22"/>
                      <line x1="40" y1="22" x2="40" y2="29" stroke="#0F6E56" stroke-width="1" opacity=".2"/>
                      <line x1="40" y1="51" x2="40" y2="58" stroke="#0F6E56" stroke-width="1" opacity=".2"/>
                    </svg>
                  </div>
              }
            </div>

            <!-- 記事ヘッダー -->
            <header class="art-header">
              <div class="art-meta-row">
                <span class={`tag tag-${post.data.category}`}>{post.data.category}</span>
                {post.data.aiGenerated && <span class="ai-dot" aria-label="AI生成記事" />}
                <time datetime={post.data.pubDate.toISOString()} class="art-date">{dateStr}</time>
              </div>
              <h1 class="art-title">{post.data.title}</h1>
            </header>

            <!-- 本文（引用文献を含む） -->
            <div class="art-body">
              <div class="prose">
                <Content />
              </div>

              <!-- X share button -->
              <div class="x-share">
                <a
                  href={xShareUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="x-share-btn"
                  aria-label="Xでシェア"
                >
                  <svg class="x-icon" viewBox="0 0 24 24" aria-hidden="true" fill="currentColor">
                    <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.744l7.73-8.835L1.254 2.25H8.08l4.253 5.622 5.911-5.622Zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
                  </svg>
                  でシェア
                </a>
              </div>
            </div>

          </article>

          <!-- ── SIDEBAR（デスクトップのみ） ── -->
          <aside class="sidebar" aria-label="サイドバー">

            <!-- 人気記事 -->
            <div class="sb-section">
              <div class="sb-label">人気記事</div>
              {popularPosts.map((p, i) => (
                <a href={`/blog/${p.slug}`} class="sb-pop-item">
                  <span class="sb-pop-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                  <span class="sb-pop-title">{p.data.title}</span>
                </a>
              ))}
            </div>

            <!-- サイドバーバナー -->
            <div class="sb-section">
              <SponsoredBanners variant="sidebar" />
            </div>

          </aside>
        </div>

        <!-- メールマガジン登録 -->
        <NewsletterSignup />

        <!-- 関連記事（記事下・フル幅） -->
        {related.length > 0 && (
          <section class="related-zone" aria-labelledby="related-heading">
            <h2 id="related-heading" class="related-label">関連記事</h2>
            <div class="related-grid">
              {related.map(p => (
                <a href={`/blog/${p.slug}`} class="related-card">
                  <div class="related-thumb">
                    {p.data.heroImage
                      ? <img src={p.data.heroImage} alt={p.data.title} loading="lazy" />
                      : <div class="related-thumb-placeholder"></div>
                    }
                  </div>
                  <div class="related-body">
                    <div class="related-meta">
                      <span class={`tag tag-${p.data.category}`}>{p.data.category}</span>
                      <time datetime={p.data.pubDate.toISOString()} class="art-date">
                        {p.data.pubDate.toLocaleDateString('ja-JP', { month: '2-digit', day: '2-digit' }).replace('/', '.')}
                      </time>
                    </div>
                    <p class="related-title">{p.data.title}</p>
                  </div>
                </a>
              ))}
            </div>
          </section>
        )}

        <!-- モバイル専用: バナー → 人気記事 -->
        <div class="mobile-extra">
          <div class="mobile-banner-zone">
            <SponsoredBanners variant="home" />
          </div>
          <section class="popular-zone" aria-labelledby="popular-heading">
            <h2 id="popular-heading" class="popular-label">人気記事</h2>
            <div class="popular-list">
              {popularPosts.map((p, i) => (
                <a href={`/blog/${p.slug}`} class="pop-item">
                  <span class="pop-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                  <span class="pop-title">{p.data.title}</span>
                </a>
              ))}
            </div>
          </section>
        </div>

      </div>
    </main>

    <Footer />
  </div>
</BaseLayout>

<style>
/* ── LAYOUT ── */
.page-wrapper { display: flex; flex-direction: column; min-height: 100vh; }
/* min-width: 0 で flex/grid アイテムが中身の最小幅まで縮まない既定を解除し、
   幅広な子要素があってもビューポート幅を超えないようにする */
.main-content { flex: 1; min-width: 0; }
.inner { max-width: 1200px; margin: 0 auto; min-width: 0; }

/* ── BREADCRUMB ── */
.breadcrumb {
  padding: 8px 24px;
  font-size: 10px;
  color: #888;
  font-family: 'Space Mono', monospace;
  border-bottom: 0.5px solid #e5e4df;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.breadcrumb a { color: #0F6E56; text-decoration: none; }
.breadcrumb a:hover { text-decoration: underline; }

/* ── ARTICLE + SIDEBAR GRID ── */
.article-wrap {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 240px;
}

/* ── MAIN ── */
/* min-width: 0 でグリッドアイテムが min-content 幅まで縮まない既定を解除する。
   これがないと表などの幅広要素が 1fr トラックを押し広げ、本文全体がはみ出す。 */
.article-main { border-right: 0.5px solid #e5e4df; min-width: 0; }

/* ── HERO IMAGE ── */
.art-hero-img {
  width: 100%;
  height: 260px;
  position: relative;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}
.art-hero-img img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}
.art-hero-img::after {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(to bottom, transparent 50%, rgba(0,0,0,0.22));
  pointer-events: none;
}
.hero-placeholder {
  width: 100%;
  height: 100%;
  background: radial-gradient(ellipse at 40% 45%, #9FE1CB 0%, #E1F5EE 45%, #b6d8cc 100%);
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ── ARTICLE HEADER ── */
.art-header {
  padding: 28px 40px 22px;
  border-bottom: 0.5px solid #e5e4df;
  max-width: 800px;
  margin: 0 auto;
}
.art-meta-row {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 14px;
  flex-wrap: wrap;
}
.art-date {
  font-family: 'Space Mono', monospace;
  font-size: 10px;
  color: #888;
}
.art-title {
  font-family: 'Noto Serif JP', serif;
  font-size: 26px;
  font-weight: 600;
  line-height: 1.65;
  color: #1a1a18;
  margin-bottom: 14px;
  letter-spacing: 0.02em;
}


/* ── ARTICLE BODY ── */
.art-body {
  padding: 40px 40px 48px;
  max-width: 800px;
  margin: 0 auto;
}

/* prose スタイル — :global() で <Content/> 内にも確実に適用 */
:global(.prose) {
  font-family: 'Noto Serif JP', serif;
}

:global(.prose p) {
  font-size: 16px;
  line-height: 2.0;
  color: #1a1a18;
  margin: 0 0 1.8em;
  letter-spacing: 0.03em;
  overflow-wrap: anywhere;
}

:global(.prose h2) {
  font-family: 'Noto Serif JP', serif;
  font-size: 22px;
  font-weight: 600;
  color: #1a1a18;
  margin: 4em 0 1.2em;
  padding-bottom: 12px;
  border-bottom: 1px solid #e5e4df;
  line-height: 1.6;
  letter-spacing: 0.03em;
}

:global(.prose h2:first-child) {
  margin-top: 0;
}

:global(.prose h3) {
  font-family: 'Noto Serif JP', serif;
  font-size: 17px;
  font-weight: 600;
  color: #1a1a18;
  margin: 3em 0 1em;
  padding-left: 14px;
  border-left: 3px solid #0F6E56;
  line-height: 1.7;
}

:global(.prose blockquote) {
  margin: 2em 0;
  padding: 18px 22px;
  background: #f5f4f0;
  border-left: 3px solid #0F6E56;
  border-radius: 0 8px 8px 0;
}

:global(.prose blockquote p) {
  font-size: 14px;
  color: #555;
  margin-bottom: 0;
  line-height: 1.85;
}

:global(.prose strong) {
  font-weight: 700;
  color: #0a0a09;
}

:global(.prose em) {
  font-style: italic;
}

/* :global() でAstroのスコープを外す（<Content/>内のaタグに確実に適用） */
:global(.prose a) {
  color: #1a6fcc;
  text-decoration: underline;
  text-underline-offset: 3px;
  text-decoration-thickness: 1px;
  transition: opacity .15s;
  overflow-wrap: anywhere;
}

:global(.prose a:hover) {
  opacity: 0.7;
}

:global(.prose ul),
:global(.prose ol) {
  padding-left: 1.8em;
  margin: 1.5em 0 2em;
}

:global(.prose li) {
  font-family: 'Noto Serif JP', serif;
  font-size: 16px;
  line-height: 1.95;
  color: #1a1a18;
  margin-bottom: 0.8em;
  padding-left: 0.3em;
  letter-spacing: 0.03em;
  overflow-wrap: anywhere;
}

:global(.prose li:last-child) {
  margin-bottom: 0;
}

:global(.prose li p) {
  margin-bottom: 0.5em;
}

:global(.prose hr) {
  border: none;
  border-top: 1px solid #e5e4df;
  margin: 3em 0;
}

:global(.prose img) {
  max-width: 100%;
  height: auto;
  margin: 2em 0;
  border-radius: 8px;
}

:global(.prose table) {
  width: 100%;
  border-collapse: collapse;
  margin: 2em 0;
  font-size: 16px;
}
:global(.prose th),
:global(.prose td) {
  padding: 10px 14px;
  border: 1px solid #e5e4df;
  line-height: 1.7;
}
:global(.prose th) {
  background: #f5f4f0;
  font-weight: 600;
  text-align: left;
}

/* スマホでは表自体を横スクロール領域にして、ページ全体がはみ出さないようにする */
@media (max-width: 600px) {
  :global(.prose table) {
    display: block;
    width: 100%;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    white-space: nowrap;
  }
}

/* ── X SHARE BUTTON ── */
.x-share {
  display: flex;
  justify-content: center;
  margin-top: 40px;
  padding-top: 32px;
  border-top: 0.5px solid #e5e4df;
}
.x-share-btn {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 10px 22px;
  background: #000;
  color: #fff;
  font-family: 'Space Mono', monospace;
  font-size: 13px;
  letter-spacing: 0.04em;
  border-radius: 6px;
  text-decoration: none;
  transition: opacity .15s;
}
.x-share-btn:hover { opacity: 0.75; }
.x-icon {
  width: 16px;
  height: 16px;
  flex-shrink: 0;
}

/* ── SIDEBAR ── */
.sidebar {
  padding: 16px;
  position: sticky;
  top: 52px;
  align-self: start;
  max-height: calc(100vh - 52px);
  overflow-y: auto;
}
.sb-section { margin-bottom: 20px; }
.sb-label {
  font-family: 'Space Mono', monospace;
  font-size: 9px;
  letter-spacing: .1em;
  color: #888;
  text-transform: uppercase;
  margin-bottom: 8px;
  padding-bottom: 6px;
  border-bottom: 0.5px solid #e5e4df;
}

/* 人気記事（サイドバー） */
.sb-pop-item {
  display: flex;
  gap: 8px;
  padding: 6px 0;
  border-bottom: 0.5px solid #e5e4df;
  text-decoration: none;
  color: inherit;
  transition: opacity .15s;
}
.sb-pop-item:hover { opacity: 0.7; }
.sb-pop-item:last-child { border-bottom: none; }
.sb-pop-num {
  font-family: 'Space Mono', monospace;
  font-size: 11px;
  font-weight: 700;
  color: #E1F5EE;
  flex-shrink: 0;
  width: 18px;
}
.sb-pop-title { font-size: 10px; color: #1a1a18; line-height: 1.55; }

/* ── RELATED ARTICLES ── */
.related-zone {
  padding: 24px 40px 32px;
  border-top: 0.5px solid #e5e4df;
  max-width: 800px;
  margin: 0 auto;
}
.related-label {
  font-family: 'Space Mono', monospace;
  font-size: 9px;
  letter-spacing: .1em;
  color: #888;
  text-transform: uppercase;
  margin-bottom: 14px;
  font-weight: 400;
}
.related-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
}
.related-card {
  display: flex;
  gap: 10px;
  padding: 10px;
  border: 0.5px solid #e5e4df;
  border-radius: 8px;
  text-decoration: none;
  color: inherit;
  transition: background .15s;
}
.related-card:hover { background: #f5f4f0; }
.related-thumb {
  width: 72px;
  height: 54px;
  border-radius: 5px;
  overflow: hidden;
  flex-shrink: 0;
  background: linear-gradient(135deg, #E1F5EE, #9FE1CB);
}
.related-thumb img { width: 100%; height: 100%; object-fit: cover; }
.related-thumb-placeholder { width: 100%; height: 100%; background: linear-gradient(135deg, #FAEEDA, #FAC775); }
.related-body { flex: 1; }
.related-meta {
  display: flex;
  align-items: center;
  gap: 6px;
  margin-bottom: 5px;
}
.related-title {
  font-family: 'Noto Serif JP', serif;
  font-size: 12px;
  font-weight: 500;
  line-height: 1.6;
  color: #1a1a18;
}

/* ── モバイル専用セクション（デスクトップでは非表示） ── */
.mobile-extra { display: none; }

/* ── RESPONSIVE ── */
@media (max-width: 900px) {
  .article-wrap { grid-template-columns: minmax(0, 1fr); }
  .article-main { border-right: none; }
  /* サイドバーを非表示にしてモバイル専用セクションを表示 */
  .sidebar { display: none; }
  .mobile-extra { display: block; }
  .mobile-banner-zone { border-top: 0.5px solid #e5e4df; border-bottom: 0.5px solid #e5e4df; }
}

@media (max-width: 600px) {
  .art-title { font-size: 20px; }
  .art-hero-img { height: 200px; }
  .art-header { padding: 18px 20px 16px; }
  .art-body { padding: 24px 20px 32px; }
  .prose p,
  .prose li {
    font-size: 15px;
    line-height: 1.9;
  }
  .prose h2 { font-size: 19px; }
  .prose h3 { font-size: 16px; }
  .related-grid { grid-template-columns: 1fr; }
  .related-zone { padding: 20px 20px 28px; }
  .breadcrumb { padding: 8px 16px; }
}

/* ── 人気記事（モバイル） ── */
.popular-zone {
  padding: 24px 20px 40px;
}
.popular-label {
  font-family: 'Space Mono', monospace;
  font-size: 9px;
  letter-spacing: .1em;
  color: #888;
  text-transform: uppercase;
  margin-bottom: 14px;
  font-weight: 400;
}
.popular-list {
  display: flex;
  flex-direction: column;
}
.pop-item {
  display: flex;
  gap: 12px;
  align-items: baseline;
  padding: 10px 0;
  border-bottom: 0.5px solid #e5e4df;
  text-decoration: none;
  color: inherit;
  transition: opacity .15s;
}
.pop-item:last-child { border-bottom: none; }
.pop-item:hover { opacity: 0.7; }
.pop-num {
  font-family: 'Space Mono', monospace;
  font-size: 11px;
  font-weight: 700;
  color: #0F6E56;
  flex-shrink: 0;
  width: 20px;
}
.pop-title {
  font-family: 'Noto Serif JP', serif;
  font-size: 14px;
  line-height: 1.65;
  color: #1a1a18;
}
</style>
