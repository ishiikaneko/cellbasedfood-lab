# Resend (既存)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Resend Audience ID (新規 — Resendダッシュボードで作成後に設定)
RESEND_AUDIENCE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# 送信元メールアドレス (独自ドメイン認証後に設定)
RESEND_FROM_EMAIL=CellBasedFood Lab <newsletter@cellbasedfood-lab.com>

# 問い合わせ通知の受信先 (フロントエンドには公開しない)
CONTACT_NOTIFICATION_EMAIL=ishiikaneko1317@gmail.com

# Resend Inbound（info@ 宛メールの受信→転送）
# Resendダッシュボードで email.received Webhook を /api/inbound-forward に登録し、
# 発行された Signing Secret を設定する
RESEND_INBOUND_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx
# 転送先（未設定なら CONTACT_NOTIFICATION_EMAIL に転送）
INBOUND_FORWARD_TO=ishiikaneko1317@gmail.com
# 転送対象の受信アドレス（カンマ区切りで複数可。未設定なら info@cellbasedfood-lab.com）
INBOUND_FORWARD_ADDRESSES=info@cellbasedfood-lab.com

# サイトURL
SITE_URL=https://cellbasedfood-lab.com

# 配信停止トークン生成用シークレット (任意の長い文字列)
UNSUBSCRIBE_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
